# Telegram Bot Configuration
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID (user ID or group ID)
# Get from @userinfobot or @RawDataBot
TELEGRAM_CHAT_ID=your_chat_id_here

# Upstash Redis (Free tier: 10k requests/day, 256MB)
# Sign up at https://upstash.com -> Create Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here

# Optional: Vercel Deployment (for auto-deploy via GitHub Actions)
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_org_id
# VERCEL_PROJECT_ID=your_project_id